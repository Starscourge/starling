# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A statically typed functional language compiled to bytecode"
description:
  "Starling is a small functional language with Lisp-style syntax, Hindley-Milner type inference, algebraic data types, exhaustive pattern matching and arbitrary-precision integers. It compiles to bytecode and runs on its own stack VM with proper tail calls."
maintainer: ["Tushman Khalse"]
authors: ["Tushman Khalse"]
license: "MIT"
homepage: "https://github.com/Starscourge/starling"
bug-reports: "https://github.com/Starscourge/starling/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "alcotest" {with-test}
  "fmt" {with-test}
  "qcheck-core" {with-test & >= "0.91"}
  "qcheck-alcotest" {with-test & >= "0.91"}
  "zarith" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Starscourge/starling.git"
